DATABASE_URL=postgres://aici:aici@localhost:5432/aici

# Make each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The database is shared, so STAFF_PASSWORD_PEPPER and DATA_ENCRYPTION_KEY must be
# the same for the whole team. Get them from a teammate, never commit them.
STAFF_PASSWORD_PEPPER=
DATA_ENCRYPTION_KEY=
ALTCHA_HMAC_KEY=

# Address of the site, used for the links in emails. Needed in production. In development
# it can stay empty, then the links use the address you opened.
APP_URL=

# Email for citizen sign up. With SMTP_HOST empty, development prints each message and its
# link in the terminal instead of sending it. For Gmail: smtp.gmail.com, port 465, your
# address as SMTP_USER and an app password as SMTP_PASS (Google account, Security,
# 2-Step Verification, App passwords). MAIL_FROM falls back to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
