DATABASE_URL=postgres://aici:aici@localhost:5432/aici

# Make each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The database is shared, so STAFF_PASSWORD_PEPPER, DATA_ENCRYPTION_KEY and APP_DB_PASSWORD
# must be the same for the whole team. Get them from a teammate, never commit them.
STAFF_PASSWORD_PEPPER=
DATA_ENCRYPTION_KEY=
ALTCHA_HMAC_KEY=

# Login password for app_data, the restricted database role ordinary queries run as (see
# lib/db-app.ts and the row-level security policies in db/init.sql). Whoever runs
# `npm run db:migrate` first sets it in the database from this value; everyone else just
# needs the same value here to connect as that role.
APP_DB_PASSWORD=

# Address of the site, used for the links in emails. Needed in production. In development
# it can stay empty, then the links use the address you opened.
APP_URL=

# Email for citizen sign up. With SMTP_HOST empty, development prints each message and its
# link in the terminal instead of sending it. For Gmail: smtp.gmail.com, port 465, your
# address as SMTP_USER and an app password as SMTP_PASS (Google account, Security,
# 2-Step Verification, App passwords). MAIL_FROM falls back to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# "true" shows report photos and descriptions on the public map. Empty keeps them for staff
# only. Faces and plates are not blurred and the texts are not reviewed yet.
PUBLIC_DETAILS=
